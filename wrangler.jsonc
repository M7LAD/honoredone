{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honoredone",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5e03d83d-f843-4d12-aabe-c53db39eafdf","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6c85871208164343a537ec38f8b2fb0c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
